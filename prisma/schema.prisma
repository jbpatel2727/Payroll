generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Users/Roles/Permissions (RBAC) models below, then business data (Branch,
// Department, Employee, Attendance, etc.) further down.

model Permission {
  id      String           @id @default(auto()) @map("_id") @db.ObjectId
  key     String           @unique
  module  String
  label   String
  roles   RolePermission[]
}

model Role {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  permissionId String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@unique([roleId, permissionId])
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  name         String
  email        String?
  phone        String?
  roleId       String   @db.ObjectId
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- Business data (employees, attendance, payroll, branches, departments) ---
// These mirror the loosely-typed shape the app has always used (previously a JSON
// blob in src/database.js) rather than a normalized relational model — branchCode/
// deptName/empId are plain string references, not Prisma relations, matching the
// existing string-matching logic throughout src/server.js. IDs are caller-supplied
// strings (the app's existing Date.now()-based ids), NOT auto-generated ObjectIds,
// so every existing id-generation/comparison call site keeps working unchanged.

model Branch {
  id      String  @id @map("_id")
  name    String?
  code    String?
  address String?
}

model Department {
  id         String  @id @map("_id")
  name       String?
  branchCode String?
  head       String?
}

// Effective-dated salary revisions for an employee. Append-only — an edit is a
// new row with a new effectiveFrom, never a mutation, so a raise on 01/10
// never retroactively changes already-generated September payroll.
model EmployeeSalaryHistory {
  id               String  @id @map("_id")
  employeeId       String?
  effectiveFrom    String?
  basic            Float?
  hra              Float?
  conveyance       Float?
  specialAllowance Float?
  otherAllowance   Float?
  bonus            Float?
  incentive        Float?
  otherEarnings    Float?
  tax              Float?
  loan             Float?
  advance          Float?
  otherDeduction   Float?
  note             String?
  createdBy        String?
  createdAt        String?
}

// Global statutory deduction/earning components (e.g. PF, ESI, Professional
// Tax). Same append-only, effective-dated pattern as EmployeeSalaryHistory —
// componentKey groups versions of "the same" component across edits; a
// "delete" inserts a new isActive:false version rather than removing history.
model StatutoryComponent {
  id            String   @id @map("_id")
  componentKey  String?
  name          String?
  type          String?
  calcType      String?
  value         Float?
  effectiveFrom String?
  isActive      Boolean? @default(true)
  createdAt     String?
}

model Employee {
  id                 String  @id @map("_id")
  empCode            String?
  name               String?
  email              String?
  phone              String?
  address            String?
  deptName           String?
  branchCode         String?
  salary             Float?
  baseSalary         Float?
  profilePhoto       String?
  workSchedule       Json?
  allowanceStructure Json?
  salaryStructure    Json?
  dateOfJoining      String?
  relievingDate      String?
  createdAt          String?
}

model Attendance {
  id              String  @id @map("_id")
  empId           String?
  empName         String?
  date            String?
  status          String?
  daysWorked      Float?
  overtimeHours   Float?
  unpaidLeave     Float?
  paidLeave       Float?
  gazettedHoliday Float?
  branchCode      String?
  deptName        String?
}

model Transfer {
  id                  String  @id @map("_id")
  employeeId          String?
  sourceBranch        String?
  targetBranch        String?
  effectiveDate       String?
  relocationAllowance Float?
  salaryRevision      Float?
  department          String?
  status              String?
  createdAt           String?
}

model PayrollRecord {
  id                  String  @id @map("_id")
  empId               String?
  empName             String?
  empCode             String?
  month               String?
  sourceBranch        String?
  targetBranch        String?
  transferDate        String?
  daysSource          Float?
  daysTarget          Float?
  totalWorkingDays    Float?
  payableDays         Float?
  lopDays             Float?
  baseSalary          Float?
  sourceGross         Float?
  targetGross         Float?
  overtimeHours       Float?
  overtimePay         Float?
  relocationAllowance Float?
  salaryRevision      Float?
  grossPay            Float?
  deductions          Float?
  lopDeduction        Float?
  statutoryDeductions Float?
  netPay              Float?
  netSalary           Float?
  branchAllocation    Json?
  hra                         Float?
  conveyance                  Float?
  specialAllowance            Float?
  otherAllowance              Float?
  bonus                       Float?
  incentive                   Float?
  otherEarnings               Float?
  tax                         Float?
  loan                        Float?
  advance                     Float?
  otherDeduction              Float?
  statutoryDeductionBreakdown Json?
  salaryStructureId           String?
  calcMethod                  String?
}

model PayrollRun {
  id          String  @id @map("_id")
  month       String?
  workingDays Float?
  generatedAt String?
  exceptions  Json?
}

model Expense {
  id           String  @id @map("_id")
  category     String?
  amount       Float?
  date         String?
  note         String?
  payrollMonth String?
  employeeId   String?
  employeeName String?
  source       String?
}

// Settings' existing data has colliding legacy ids across categories (e.g. a
// 'shift' record and a 'salaryComponent' record both using id 1), so unlike the
// other business models above, this one uses a real auto-generated ObjectId.
model Setting {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  category  String?
  name      String?
  values    Json?
  createdAt String?
}
